# KEO Hairven — your own project credentials only.
# Copy to .env.local locally; set the same variables in your hosting dashboard.
# Never commit real values. NEXT_PUBLIC_* values are built into browser assets:
# rebuild after changing them. All other values below are server-only.

# Final production HTTPS origin. Use http://localhost:3000 for local development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase web app from your own project. Enable an authentication provider,
# create the admin user and add the deployed domain to authorised domains.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase service account from the SAME project. Create Firestore first.
# For hosting dashboards, a quoted key with literal \n separators is supported.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Comma-separated bootstrap allowlists. Email must be verified for allowlist access.
# Alternatively grant server-side {admin:true,role:"owner"|"editor"} custom claims
# using npm run admin:grant after creating the Firebase Authentication user.
ADMIN_OWNER_EMAILS=
ADMIN_EDITOR_EMAILS=

# Cloudinary signed uploads. No browser-visible API secret.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# Generate each secret independently: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep the encryption key stable after saving Gemini connections in Admin.
AI_KEYS_ENCRYPTION_KEY_BASE64=
SESSION_CSRF_SECRET=

# Optional launch shortcut: environment-managed Gemini connection.
# Alternatively add encrypted connections at /admin/ai. Those are tried first.
# KEO Muse requires Firebase + SESSION_CSRF_SECRET for durable usage limits.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional: only use a header your deployment platform reliably overwrites.
# Without this, per-session limits are advisory; the global daily cap is still hard.
# Add a platform/WAF rate limit to /api/chat for protection against public abuse.
AI_TRUSTED_IP_HEADER=

# Schedule GET /api/cron/trash with Authorization: Bearer <this secret>.
# Use your host scheduler or an external scheduler every five minutes.
TRASH_CRON_SECRET=
