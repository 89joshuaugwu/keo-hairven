# KEO Hairven — production environment template
# Copy to .env.local for local work. Keep real values out of Git and handoff ZIPs.

# REQUIRED FOR CORRECT CANONICAL LINKS / SEO IN PRODUCTION.
# Use the final public origin with no trailing slash.
# Example: https://your-domain.example
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase browser config — required for Admin email/password + Google sign-in.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin — required for protected Admin APIs, public projections,
# Ask KEO counters/settings and the one-time DO NOT reuse the original source database.
# NEVER prefix these with NEXT_PUBLIC_.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Cloudinary — required for Admin media uploads and for copying packaged media during the DO NOT reuse the original source database.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional if your Cloudinary workflow uses a preset; signed uploads work without it.
CLOUDINARY_UPLOAD_PRESET=

# Security bootstrap secrets.
# Generate a strong 32-byte base64 key once and keep it stable so saved AI keys remain decryptable.
AI_KEYS_ENCRYPTION_KEY_BASE64=
# Generate a strong random secret and keep it stable for CSRF/rate-limit hashing.
SESSION_CSRF_SECRET=

# Admin authorization.
# Preferred production authority: Firebase custom claims { admin: true, role: "owner" | "editor" }.
# These comma-separated allowlists remain a bootstrap/fallback.
ADMIN_OWNER_EMAILS=
ADMIN_EDITOR_EMAILS=

# IMPORTANT:
# Gemini keys, Gemini model IDs and the AI daily request cap are NOT ENV settings anymore.
# Manage them from /admin/ai so they can be changed without redeploying.

# Server-only bearer secret for GET /api/cron/trash. Configure a five-minute scheduler.
TRASH_CRON_SECRET=
